generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum IncidentType {
  AIRCRAFT_ACCIDENT
  DISASTER_RELIEF
}

enum IncidentStatus {
  RECEIVED
  FORWARDED
  INSPECTING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum IncidentPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AdminRole {
  SUPER_ADMIN
  SUPERVISOR
  OFFICER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthenticationProvider {
  DEVELOPMENT
  FACEBOOK
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_ASSIGNED
  INCIDENT_STATUS_CHANGED
  SYSTEM
}

enum PlatformType {
  IOS
  ANDROID
  WEB
}

enum TokenOwnerType {
  CITIZEN
  ADMIN
}

model CitizenUser {
  id                 String             @id @default(uuid()) @db.Char(36)
  facebookId         String?            @unique @db.VarChar(191)
  fullName           String             @db.VarChar(191)
  email              String?            @db.VarChar(320)
  profileImageUrl    String?            @db.VarChar(2048)
  phone              String?            @db.VarChar(32)
  status             UserStatus         @default(ACTIVE)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  incidents          Incident[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  externalIdentities ExternalIdentity[]
}

model ExternalIdentity {
  id             String                 @id @default(uuid()) @db.Char(36)
  citizenUserId  String                 @db.Char(36)
  provider       AuthenticationProvider
  providerUserId String                 @db.VarChar(191)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  citizenUser    CitizenUser            @relation(fields: [citizenUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([citizenUserId])
}

model AdminUser {
  id                  String                  @id @default(uuid()) @db.Char(36)
  username            String                  @unique @db.VarChar(100)
  email               String?                 @unique @db.VarChar(320)
  passwordHash        String                  @db.VarChar(255)
  fullName            String                  @db.VarChar(191)
  phone               String?                 @db.VarChar(32)
  role                AdminRole
  status              UserStatus              @default(ACTIVE)
  lastLoginAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  assignedIncidents   Incident[]              @relation("CurrentAssignee")
  statusChanges       IncidentStatusHistory[]
  notes               IncidentNote[]
  assignmentsReceived IncidentAssignment[]    @relation("AssignedTo")
  assignmentsCreated  IncidentAssignment[]    @relation("AssignedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]
  updatedSettings     SystemSetting[]
}

model Incident {
  id                  String                  @id @default(uuid()) @db.Char(36)
  caseCode            String                  @unique @db.VarChar(32)
  clientRequestId     String?                 @unique @db.VarChar(191)
  citizenUserId       String                  @db.Char(36)
  reporterName        String                  @db.VarChar(191)
  reporterPhone       String                  @db.VarChar(32)
  type                IncidentType
  description         String                  @db.Text
  latitude            Decimal                 @db.Decimal(10, 7)
  longitude           Decimal                 @db.Decimal(11, 7)
  address             String                  @db.Text
  subdistrict         String?                 @db.VarChar(191)
  district            String?                 @db.VarChar(191)
  province            String?                 @db.VarChar(191)
  postalCode          String?                 @db.VarChar(16)
  status              IncidentStatus          @default(RECEIVED)
  priority            IncidentPriority        @default(NORMAL)
  assignedAdminUserId String?                 @db.Char(36)
  reportedAt          DateTime                @default(now())
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  citizenUser         CitizenUser             @relation(fields: [citizenUserId], references: [id])
  assignedAdminUser   AdminUser?              @relation("CurrentAssignee", fields: [assignedAdminUserId], references: [id])
  images              IncidentImage[]
  statusHistory       IncidentStatusHistory[]
  notes               IncidentNote[]
  assignments         IncidentAssignment[]
  notifications       Notification[]

  @@index([status])
  @@index([type])
  @@index([reportedAt])
  @@index([citizenUserId])
  @@index([assignedAdminUserId])
  @@index([province])
  @@index([createdAt])
  @@index([priority])
  @@index([status, reportedAt])
}

model IncidentImage {
  id            String   @id @default(uuid()) @db.Char(36)
  incidentId    String   @db.Char(36)
  fileName      String   @db.VarChar(255)
  originalName  String   @db.VarChar(255)
  mimeType      String   @db.VarChar(100)
  fileSize      Int
  storageDriver String   @db.VarChar(50)
  storageKey    String   @db.VarChar(1024)
  imageUrl      String   @db.VarChar(2048)
  createdAt     DateTime @default(now())
  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentStatusHistory {
  id                   String          @id @default(uuid()) @db.Char(36)
  incidentId           String          @db.Char(36)
  fromStatus           IncidentStatus?
  toStatus             IncidentStatus
  note                 String?         @db.Text
  changedByAdminUserId String?         @db.Char(36)
  changedAt            DateTime        @default(now())
  incident             Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedByAdminUser   AdminUser?      @relation(fields: [changedByAdminUserId], references: [id])

  @@index([incidentId, changedAt])
}

model IncidentNote {
  id                 String    @id @default(uuid()) @db.Char(36)
  incidentId         String    @db.Char(36)
  adminUserId        String    @db.Char(36)
  note               String    @db.Text
  isVisibleToCitizen Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  incident           Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  adminUser          AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([incidentId])
  @@index([adminUserId])
}

model IncidentAssignment {
  id                    String    @id @default(uuid()) @db.Char(36)
  incidentId            String    @db.Char(36)
  assignedToAdminUserId String    @db.Char(36)
  assignedByAdminUserId String    @db.Char(36)
  assignedAt            DateTime  @default(now())
  unassignedAt          DateTime?
  incident              Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignedToAdminUser   AdminUser @relation("AssignedTo", fields: [assignedToAdminUserId], references: [id])
  assignedByAdminUser   AdminUser @relation("AssignedBy", fields: [assignedByAdminUserId], references: [id])

  @@index([incidentId, assignedAt])
  @@index([assignedToAdminUserId, unassignedAt])
}

model Notification {
  id            String           @id @default(uuid()) @db.Char(36)
  citizenUserId String?          @db.Char(36)
  adminUserId   String?          @db.Char(36)
  incidentId    String?          @db.Char(36)
  title         String           @db.VarChar(255)
  message       String           @db.Text
  type          NotificationType
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())
  citizenUser   CitizenUser?     @relation(fields: [citizenUserId], references: [id])
  adminUser     AdminUser?       @relation(fields: [adminUserId], references: [id])
  incident      Incident?        @relation(fields: [incidentId], references: [id])

  @@index([citizenUserId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([citizenUserId, isRead])
  @@index([adminUserId, isRead])
  @@index([isRead])
  @@index([createdAt])
}

model DeviceToken {
  id            String       @id @default(uuid()) @db.Char(36)
  citizenUserId String       @db.Char(36)
  token         String       @unique @db.VarChar(512)
  platform      PlatformType
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  citizenUser   CitizenUser  @relation(fields: [citizenUserId], references: [id])

  @@index([citizenUserId, isActive])
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Char(36)
  ownerType         TokenOwnerType
  ownerId           String         @db.Char(36)
  tokenHash         String         @db.VarChar(255)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?        @unique @db.Char(36)
  createdAt         DateTime       @default(now())
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesToken     RefreshToken?  @relation("RefreshTokenRotation")

  @@index([ownerType, ownerId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Char(36)
  adminUserId String?    @db.Char(36)
  action      String     @db.VarChar(100)
  entityType  String     @db.VarChar(100)
  entityId    String?    @db.VarChar(191)
  oldValue    Json?
  newValue    Json?
  ipAddress   String?    @db.VarChar(45)
  userAgent   String?    @db.Text
  createdAt   DateTime   @default(now())
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([action])
  @@index([entityType])
}

model SystemSetting {
  id                   String     @id @default(uuid()) @db.Char(36)
  key                  String     @unique @db.VarChar(191)
  value                Json
  updatedByAdminUserId String?    @db.Char(36)
  updatedAt            DateTime   @updatedAt
  updatedByAdminUser   AdminUser? @relation(fields: [updatedByAdminUserId], references: [id])
}

model CaseCounter {
  id         String   @id @default(uuid()) @db.Char(36)
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
