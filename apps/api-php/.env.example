APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
CORS_ORIGINS=http://localhost:4200

DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=police_incident
DB_USERNAME=police
DB_PASSWORD=change-me

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

DEV_AUTH_BYPASS=false
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_GRAPH_API_VERSION=v23.0
LINE_LOGIN_ENABLED=false
LINE_CHANNEL_ID=

FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_PROJECT_ID=sar-police-emc
FIREBASE_DATABASE_URL=https://sar-police-emc-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

FCM_ENABLED=false
IMAGE_PUBLIC_URL=/image_emer
IMAGE_STORAGE_PATH=../../public_html/image_emer
IMAGE_STORAGE_QUOTA_BYTES=4294967296
IMAGE_STORAGE_WARN_PERCENT=80
IMAGE_STORAGE_STOP_PERCENT=95

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=ผู้ดูแลระบบ
