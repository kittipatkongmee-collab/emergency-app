{
  "name": "police/incident-api-php",
  "description": "PHP 5.6 API for the Police Incident System",
  "type": "project",
  "require": {
    "php": "^5.6",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "nikic/fast-route": "1.3.0"
  },
  "autoload": {
    "classmap": [
      "src/Support.php",
      "src/Security.php",
      "src/Firebase.php",
      "src/Storage.php"
    ],
    "psr-4": {
      "Police\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Police\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "5.6.40"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:integration": "php tests/integration.php",
    "test:contract": "php tests/contract.php"
  }
}
