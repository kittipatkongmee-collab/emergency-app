{
  "name": "police-incident-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start:services": "pnpm db:start && pnpm dev",
    "start:backend": "pnpm db:start && pnpm dev:api",
    "start:web": "pnpm dev:web",
    "start:app": "pnpm mobile:run:android",
    "start:app:web": "pnpm mobile:run:web",
    "start:docker": "docker compose up --build",
    "stop:docker": "docker compose stop",
    "dev:api": "pnpm --filter @police/api start:dev",
    "dev:web": "pnpm --filter @police/admin-web start",
    "dev": "pnpm --parallel --filter @police/api --filter @police/admin-web run start:dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "format": "pnpm -r --if-present run format",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:status": "docker compose ps postgres",
    "db:migrate": "pnpm --filter @police/api prisma:migrate",
    "db:seed": "pnpm --filter @police/api prisma:seed",
    "db:studio": "pnpm --filter @police/api prisma:studio",
    "mobile:get": "cd apps/mobile && flutter pub get",
    "mobile:run": "cd apps/mobile && flutter run --dart-define=APP_ENV=development",
    "mobile:run:android": "cd apps/mobile && flutter run -d emulator-5554 --dart-define=APP_ENV=development --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1 --dart-define=SOCKET_URL=http://10.0.2.2:3000",
    "mobile:run:web": "cd apps/mobile && flutter run -d chrome --dart-define=APP_ENV=development --dart-define=API_BASE_URL=http://localhost:3000/api/v1 --dart-define=SOCKET_URL=http://localhost:3000",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test"
  }
}
