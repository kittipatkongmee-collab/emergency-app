{
  "name": "police-incident-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node scripts/start-development.mjs",
    "start:all": "pnpm start",
    "start:services": "pnpm db:start && pnpm dev",
    "start:backend": "pnpm db:start && pnpm dev:api",
    "start:web": "pnpm dev:web",
    "start:app": "pnpm mobile:run:android",
    "start:app:web": "pnpm mobile:run:web",
    "start:docker": "node scripts/run-with-env.mjs docker compose up --build",
    "stop:docker": "node scripts/run-with-env.mjs docker compose stop",
    "dev:api": "node scripts/run-with-env.mjs pnpm --filter @police/api start:dev",
    "dev:web": "pnpm --filter @police/admin-web start",
    "dev:web:open": "pnpm --filter @police/admin-web exec ng serve --open",
    "dev": "node scripts/run-with-env.mjs pnpm --parallel --filter @police/api --filter @police/admin-web run start:dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "test:api:e2e": "powershell -ExecutionPolicy Bypass -File scripts/test-api-e2e.ps1",
    "format": "pnpm -r --if-present run format",
    "env:configure": "node scripts/configure-development-env.mjs",
    "env:set-development-admin-password": "node scripts/set-development-admin-password.mjs",
    "db:start": "node scripts/run-with-env.mjs docker compose up -d mysql",
    "db:stop": "node scripts/run-with-env.mjs docker compose stop mysql",
    "db:status": "node scripts/run-with-env.mjs docker compose ps mysql",
    "db:format": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:format",
    "db:generate": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:generate",
    "db:validate": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:validate",
    "db:migrate": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:migrate",
    "db:migrate:deploy": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:deploy",
    "db:seed": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:seed",
    "db:studio": "node scripts/run-with-env.mjs pnpm --filter @police/api prisma:studio",
    "db:reset": "powershell -ExecutionPolicy Bypass -File scripts/reset-database.ps1 -Target Development -Seed",
    "db:test:migrate": "powershell -ExecutionPolicy Bypass -File scripts/migrate-test-database.ps1",
    "db:test:reset": "powershell -ExecutionPolicy Bypass -File scripts/reset-database.ps1 -Target Test",
    "db:check": "node scripts/run-with-env.mjs pnpm --filter @police/api check:db",
    "db:clear:development-citizens": "node scripts/run-with-env.mjs pnpm --filter @police/api clear:development-citizens",
    "db:verify:mysql": "node scripts/run-with-env.mjs pnpm --filter @police/api verify:mysql",
    "mobile:get": "cd apps/mobile && flutter pub get",
    "mobile:run": "cd apps/mobile && flutter run --dart-define=APP_ENV=development --dart-define=DEV_AUTH_BYPASS=true",
    "mobile:run:android": "node scripts/run-with-env.mjs node scripts/run-mobile-android.mjs",
    "mobile:run:web": "cd apps/mobile && flutter run -d chrome --dart-define=APP_ENV=development --dart-define=DEV_AUTH_BYPASS=true --dart-define=API_BASE_URL=http://localhost:3000/api/v1 --dart-define=SOCKET_URL=http://localhost:3000",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test",
    "test:launcher": "node --test scripts/run-mobile-android.test.mjs scripts/start-development.test.mjs"
  }
}
